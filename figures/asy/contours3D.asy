void draw_funnel_ring(path3 ring, triple center, triple cam, int segs=60) {
    real L = arclength(ring);
    triple view_dir = unit(cam - center); // direction from funnel axis to eye

    for (int k = 0; k < segs; ++k) {
        real s0 = (k / (real)segs) * L;
        real s1 = ((k + 1) / (real)segs) * L;
        path3 sub = subpath(ring, arctime(ring, s0), arctime(ring, s1));
        
        triple mid = arcpoint(ring, 0.5 * (s0 + s1));
        triple outward = unit((mid.x - center.x, mid.y - center.y, 0));

        // Front-facing vs. rear-facing
        if (dot(outward, view_dir) > 0) {
            draw(sub, black + 1.1pt);                // Front half: solid
        } else {
            draw(sub, gray(0.4) + 0.6pt + dashed);   // Back half: dashed
        }
    }
}
// 1. Create vector<vector<triple>> raw_contours
triple[][] raw_contours = {
raw_a, raw_b, raw_c, raw_d, raw_e, raw_f, raw_g, raw_h, raw_i, raw_j, raw_k, raw_l, raw_m, raw_n};
int N_levels = 14;
// 2. Build closed splines and resample them uniformly
int M_samples = 64; // # of radial stations around each ring
triple[][] P; // The structured N x M grid for the surface
// Transform each level from raw data to evenly-spaced
// grid points - first shift and scale the data
for (triple[] pts : raw_contours) {
   guide3 gn;
   for (triple p : pts) {
      gn = gn .. (p.x, p.y, p.z);
   }
   gn = gn .. cycle;
   path3 pn = gn;   // eval cubic Bezier in isotropic space
   triple[] row;
   real total_L = arclength(pn);
   for (int j=0; j<M_samples; ++j) {
      real s = (j/(real)M_samples) * total_L;
      row.push(arcpoint(pn, s));
   }
   // append the first point to close the loop
   row.push(row[0]);
   P.push(row);
   // Optional: Draw the actual continuous contour ring on the figure
	// Method 2: projected 2D halos
	// draw(pn, white + 4.0pt);
	// draw(pn, white + 1.0pt);
	// draw(pn, black + 0.8pt);
	draw(pn, black + 1.0pt);
	//
	// draw_funnel_ring(pn, (0,0,2), cam, 60);
}

