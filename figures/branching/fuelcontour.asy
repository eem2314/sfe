(300.034, -3.01507e-19), (276.417, 4.31333), (259.083, 8.46124), (246.27, 12.2928), (236.87, 15.6588), (229.94, 18.5223), (224.78, 20.9082), (220.899, 22.8688), (217.952, 24.4642), (215.697, 25.7536), (213.961, 26.7902), (212.616, 27.6205), (211.57, 28.2836), (210.754, 28.812), (210.115, 29.2324), (209.614, 29.5663), (209.244, 29.816), (209.04, 29.954), (208.972, 30), (208.905, 30.046), (208.703, 30.1841), (208.336, 30.4361), (207.844, 30.7784), (207.226, 31.2134), (206.453, 31.7671), (205.487, 32.4727), (204.286, 33.3738), (202.799, 34.5271), (200.969, 36.0075), (198.731, 37.9144), (196.021, 40.381), (192.776, 43.5877), (188.948, 47.7812), (184.515, 53.3022), (179.502, 60.6241), (174.078, 70.258), (169.643, 79.9474), (165.972, 89.6823), (164.37, 94.565), (162.745, 100)};
